SERVICE_NAME=supplier-service
SERVICE_VERSION=1.0.0
SUPPLIER_SERVICE_PORT=4005
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

DATABASE_URL="mysql://erp:erp_password@mysql:3306/erp_supplier"

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-clients

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=erp:

RABBITMQ_URL=amqp://erp:erp_password@rabbitmq:5672
RABBITMQ_EXCHANGE=erp.events
RABBITMQ_DLX=erp.events.dlx

# Internal service endpoints
MASTER_SERVICE_URL=http://master-service:4004
FILE_SERVICE_URL=http://file-service:4016
INTERNAL_TIMEOUT_MS=5000

SUPPLIER_CACHE_TTL=600
DOCUMENT_EXPIRY_WARN_DAYS=30
DOCUMENT_EXPIRY_CRON=0 6 * * *
RATING_RECALC_CRON=30 2 * * 1

QUEUE_PREFIX=erp
QUEUE_CONCURRENCY=2
RUN_WORKERS_INLINE=true
