{
  "name": "erp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise ERP Backend - Electronic Components Trading",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "gateway:dev": "npm run dev --workspace=@erp/api-gateway",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "auth:dev": "npm run dev --workspace=@erp/auth-service",
    "auth:worker": "npm run worker --workspace=@erp/auth-service",
    "auth:migrate": "npm run prisma:migrate --workspace=@erp/auth-service",
    "auth:seed": "npm run seed --workspace=@erp/auth-service",
    "role:dev": "npm run dev --workspace=@erp/role-service",
    "role:migrate": "npm run prisma:migrate --workspace=@erp/role-service",
    "role:seed": "npm run seed --workspace=@erp/role-service",
    "user:dev": "npm run dev --workspace=@erp/user-service",
    "user:worker": "npm run worker --workspace=@erp/user-service",
    "audit:dev": "npm run dev --workspace=@erp/audit-service",
    "audit:worker": "npm run worker --workspace=@erp/audit-service",
    "audit:migrate": "npm run prisma:migrate --workspace=@erp/audit-service",
    "file:dev": "npm run dev --workspace=@erp/file-service",
    "file:worker": "npm run worker --workspace=@erp/file-service",
    "file:migrate": "npm run prisma:migrate --workspace=@erp/file-service",
    "master:dev": "npm run dev --workspace=@erp/master-service",
    "master:migrate": "npm run prisma:migrate --workspace=@erp/master-service",
    "master:seed": "npm run seed --workspace=@erp/master-service",
    "supplier:dev": "npm run dev --workspace=@erp/supplier-service",
    "supplier:worker": "npm run worker --workspace=@erp/supplier-service",
    "supplier:migrate": "npm run prisma:migrate --workspace=@erp/supplier-service",
    "crm:dev": "npm run dev --workspace=@erp/crm-service",
    "crm:worker": "npm run worker --workspace=@erp/crm-service",
    "crm:migrate": "npm run prisma:migrate --workspace=@erp/crm-service",
    "rfq:dev": "npm run dev --workspace=@erp/rfq-service",
    "rfq:worker": "npm run worker --workspace=@erp/rfq-service",
    "rfq:migrate": "npm run prisma:migrate --workspace=@erp/rfq-service",
    "purchase:dev": "npm run dev --workspace=@erp/purchase-service",
    "purchase:worker": "npm run worker --workspace=@erp/purchase-service",
    "purchase:migrate": "npm run prisma:migrate --workspace=@erp/purchase-service",
    "user:seed": "npm run seed --workspace=@erp/user-service",
    "supplier:seed": "npm run seed --workspace=@erp/supplier-service",
    "crm:seed": "npm run seed --workspace=@erp/crm-service",
    "warehouse:seed": "npm run seed --workspace=@erp/warehouse-service",
    "inventory:seed": "npm run seed --workspace=@erp/inventory-service",
    "quality:seed": "npm run seed --workspace=@erp/quality-service",
    "purchase:seed": "npm run seed --workspace=@erp/purchase-service",
    "rfq:seed": "npm run seed --workspace=@erp/rfq-service",
    "sales:seed": "npm run seed --workspace=@erp/sales-service",
    "finance:seed": "npm run seed --workspace=@erp/finance-service",
    "shipment:seed": "npm run seed --workspace=@erp/shipment-service",
    "notification:seed": "npm run seed --workspace=@erp/notification-service",
    "file:seed": "npm run seed --workspace=@erp/file-service",
    "audit:seed": "npm run seed --workspace=@erp/audit-service",
    "seed:all": "npm run role:seed && npm run auth:seed && npm run user:seed && npm run master:seed && npm run supplier:seed && npm run crm:seed && npm run warehouse:seed && npm run inventory:seed && npm run quality:seed && npm run purchase:seed && npm run rfq:seed && npm run sales:seed && npm run finance:seed && npm run shipment:seed && npm run notification:seed && npm run file:seed && npm run audit:seed"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
