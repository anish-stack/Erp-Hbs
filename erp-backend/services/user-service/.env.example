SERVICE_NAME=user-service
SERVICE_VERSION=1.0.0
USER_SERVICE_PORT=4002
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

DATABASE_URL="mysql://erp:erp_password@mysql:3306/erp_auth"

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-clients
BCRYPT_ROUNDS=12

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=erp:

RABBITMQ_URL=amqp://erp:erp_password@rabbitmq:5672
RABBITMQ_EXCHANGE=erp.events
RABBITMQ_DLX=erp.events.dlx

QUEUE_PREFIX=erp
QUEUE_CONCURRENCY=3
RUN_WORKERS_INLINE=true
EXPORT_DIR=./storage/exports
IMPORT_DIR=./storage/imports
EXPORT_RETENTION_HOURS=24
IMPORT_MAX_ROWS=5000
IMPORT_MAX_FILE_MB=10
USER_CACHE_TTL=300
