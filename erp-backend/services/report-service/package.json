{
  "name": "@erp/report-service",
  "version": "1.0.0",
  "private": true,
  "description": "ERP Report Service - async Excel/CSV report generation via BullMQ, pulling data from other services",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/queues/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "prisma": { "schema": "prisma/schema.prisma" },
  "dependencies": {
    "@erp/shared": "file:../../packages/shared",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.28.1",
    "express": "^4.21.1",
    "joi": "^17.13.3",
    "exceljs": "^4.4.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": { "prisma": "^5.22.0" },
  "engines": { "node": ">=20.0.0" }
}
