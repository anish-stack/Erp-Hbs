SERVICE_NAME=api-gateway
SERVICE_VERSION=1.0.0
GATEWAY_PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1
GATEWAY_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
PROXY_TIMEOUT_MS=30000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_MS=30000
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-clients
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=erp:
AUTH_SERVICE_URL=http://auth-service:4001
USER_SERVICE_URL=http://user-service:4002
ROLE_SERVICE_URL=http://role-service:4003
MASTER_SERVICE_URL=http://master-service:4004
SUPPLIER_SERVICE_URL=http://supplier-service:4005
CRM_SERVICE_URL=http://crm-service:4006
RFQ_SERVICE_URL=http://rfq-service:4007
PURCHASE_SERVICE_URL=http://purchase-service:4008
INVENTORY_SERVICE_URL=http://inventory-service:4009
WAREHOUSE_SERVICE_URL=http://warehouse-service:4010
QUALITY_SERVICE_URL=http://quality-service:4011
SALES_SERVICE_URL=http://sales-service:4012
FINANCE_SERVICE_URL=http://finance-service:4013
SHIPMENT_SERVICE_URL=http://shipment-service:4014
NOTIFICATION_SERVICE_URL=http://notification-service:4015
FILE_SERVICE_URL=http://file-service:4016
REPORT_SERVICE_URL=http://report-service:4017
DASHBOARD_SERVICE_URL=http://dashboard-service:4018
AUDIT_SERVICE_URL=http://audit-service:4019
