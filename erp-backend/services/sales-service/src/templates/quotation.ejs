<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Quotation - The Chips Vally</title>
<style>
    *, *::before, *::after { box-sizing: border-box; }
    @page {
        size: A4;
        margin: 12mm 12mm;
        background-color: #ffffff;
    }
    body {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #1e293b;
        background-color: #ffffff;
        margin: 0;
        padding: 0;
        font-size: 9.5pt;
        line-height: 1.35;
    }

    .header-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
        border-bottom: 2px solid #312e81;
        padding-bottom: 12px;
    }
    .header-table td { vertical-align: top; padding: 0; }
    .logo-area { width: 60%; }
    .company-meta { width: 40%; text-align: right; font-size: 8.5pt; color: #334155; }

    .brand-title { font-size: 20pt; font-weight: 800; color: #312e81; letter-spacing: 0.5px; margin: 0 0 2px 0; }
    .brand-subtitle { font-size: 10pt; font-weight: 600; color: #4338ca; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 8px 0; }

    .doc-title-bar {
        background-color: #312e81;
        color: #ffffff;
        padding: 8px 12px;
        font-size: 12pt;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-align: center;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

    .info-table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
    .info-table td { vertical-align: top; width: 50%; padding: 0; }
    .info-box { background-color: #EEF2FF; border: 1px solid #c7d2fe; border-left: 3px solid #4338ca; padding: 10px 12px; height: 100%; }
    .info-box-right { border-left: 3px solid #312e81; }
    .info-heading { font-size: 9.5pt; font-weight: 700; color: #312e81; margin: 0 0 6px 0; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #c7d2fe; padding-bottom: 3px; }
    .info-row { margin-bottom: 4px; }
    .info-label { font-weight: 600; color: #334155; display: inline-block; width: 105px; }
    .info-value { color: #1e293b; }

    .item-table { width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 8.5pt; }
    .item-table th {
        background-color: #312e81;
        color: #ffffff;
        font-weight: 600;
        text-align: center;
        padding: 6px 4px;
        border: 1px solid #312e81;
        text-transform: uppercase;
        font-size: 7.5pt;
        letter-spacing: 0.3px;
    }
    .item-table td { border: 1px solid #cbd5e1; padding: 6px 5px; vertical-align: middle; }
    .item-table tr:nth-child(even) { background-color: #EEF2FF; }
    .item-table tr:nth-child(odd) { background-color: #ffffff; }
    .text-center { text-align: center; }
    .text-right { text-align: right; }

    .summary-table-container { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
    .summary-table-container td { vertical-align: top; padding: 0; }
    .amount-words-cell { width: 55%; padding-right: 15px; }
    .totals-cell { width: 45%; }

    .words-box { background-color: #FEF9C3; border: 1px solid #fde047; border-left: 3px solid #ca8a04; padding: 10px; margin-bottom: 10px; }
    .words-title { font-weight: 700; color: #713f12; font-size: 8.5pt; text-transform: uppercase; margin-bottom: 4px; }
    .words-content { font-style: italic; color: #422006; font-size: 9pt; font-weight: 600; }

    .totals-table { width: 100%; border-collapse: collapse; font-size: 9pt; }
    .totals-table td { border: 1px solid #cbd5e1; padding: 5px 8px; }
    .totals-label { font-weight: 600; color: #334155; background-color: #EEF2FF; text-align: left; }
    .totals-value { text-align: right; color: #1e293b; font-weight: 600; background-color: #ffffff; }
    .grand-total-row td { background-color: #312e81 !important; color: #ffffff !important; font-weight: 700 !important; font-size: 10pt; border-color: #312e81 !important; }
    .grand-total-row .totals-label { background-color: #312e81 !important; color: #ffffff !important; }

    .terms-section-table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
    .terms-section-table td { width: 50%; vertical-align: top; padding: 0; }
    .terms-box { background-color: #EEF2FF; border: 1px solid #c7d2fe; padding: 10px 12px; height: 100%; }
    .section-title { font-size: 9pt; font-weight: 700; color: #312e81; text-transform: uppercase; margin: 0 0 6px 0; border-bottom: 1px solid #c7d2fe; padding-bottom: 3px; letter-spacing: 0.5px; }
    .terms-list { margin: 0; padding-left: 15px; font-size: 8pt; color: #334155; line-height: 1.4; }
    .terms-list li { margin-bottom: 3px; }

    .sig-notice { font-size: 7.5pt; color: #475569; font-style: italic; }
    .sig-box { text-align: right; margin-top: 15px; }
    .sig-company { font-weight: 700; color: #312e81; font-size: 9pt; margin-bottom: 35px; }
    .sig-line { border-top: 1px solid #94a3b8; display: inline-block; width: 180px; margin-bottom: 3px; }
    .sig-title { font-size: 8pt; font-weight: 600; color: #334155; }

    .logo-container { display: inline-block; vertical-align: middle; margin-right: 10px; }
    .logo-svg { width: 44px; height: 44px; vertical-align: middle; }
    .brand-text-block { display: inline-block; vertical-align: middle; }

    @media print {
        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
</style>
</head>
<body>

<!-- Header Section -->
<table class="header-table">
    <tr>
        <td class="logo-area">
            <div class="logo-container">
                <svg class="logo-svg" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="64" height="64" rx="10" fill="#312e81"/>
                    <path d="M12 32H24L30 24H42L48 32H52" stroke="#a5b4fc" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="12" cy="32" r="3" fill="#a5b4fc"/>
                    <circle cx="52" cy="32" r="3" fill="#a5b4fc"/>
                    <rect x="22" y="20" width="20" height="24" rx="3" fill="#4338ca" stroke="#e0e7ff" stroke-width="1.5"/>
                    <rect x="26" y="24" width="12" height="16" rx="1" fill="#312e81"/>
                    <path d="M26 20V16M32 20V16M38 20V16M26 44V48M32 44V48M38 44V48" stroke="#e0e7ff" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="brand-text-block">
                <h1 class="brand-title"><%= company.name %></h1>
                <div class="brand-subtitle"><%= company.tagline %></div>
            </div>
        </td>
        <td class="company-meta">
            <strong><%= company.addressLine1 %></strong><br>
            <%= company.addressLine2 %><br>
            Phone: <%= company.phone %><br>
            Email: <%= company.email %><br>
            Web: <%= company.website %><br>
            <strong>GSTIN:</strong> <%= company.gstin %>
        </td>
    </tr>
</table>

<!-- Document Title -->
<div class="doc-title-bar">
    Quotation
</div>

<!-- Quotation & Customer Info -->
<table class="info-table">
    <tr>
        <td style="padding-right: 6px;">
            <div class="info-box">
                <div class="info-heading">Customer Details</div>
                <div class="info-row">
                    <span class="info-label">Customer Name:</span>
                    <span class="info-value"><strong><%= customerName %></strong></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Address:</span>
                    <span class="info-value"><%- customerAddress %></span>
                </div>
                <div class="info-row" style="margin-top: 4px;">
                    <span class="info-label">GSTIN:</span>
                    <span class="info-value"><%= customerGstin %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Contact Person:</span>
                    <span class="info-value"><%= contactPerson %></span>
                </div>
            </div>
        </td>
        <td style="padding-left: 6px;">
            <div class="info-box info-box-right">
                <div class="info-heading">Quotation Information</div>
                <div class="info-row">
                    <span class="info-label">Quotation No.:</span>
                    <span class="info-value"><strong><%= code %></strong></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Quotation Date:</span>
                    <span class="info-value"><%= quoteDate %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Valid Until:</span>
                    <span class="info-value"><%= validUntil %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Payment Terms:</span>
                    <span class="info-value"><%= paymentTerms %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Sales Executive:</span>
                    <span class="info-value"><%= salesExecutive %></span>
                </div>
            </div>
        </td>
    </tr>
</table>

<!-- Itemized Table -->
<table class="item-table">
    <thead>
        <tr>
            <th style="width: 5%;">S.No.</th>
            <th style="width: 15%;">Part Number</th>
            <th style="width: 22%;">Product Description</th>
            <th style="width: 14%;">Manufacturer</th>
            <th style="width: 6%;">Qty</th>
            <th style="width: 6%;">Unit</th>
            <th style="width: 9%;">Unit Price (₹)</th>
            <th style="width: 7%;">Disc. (%)</th>
            <th style="width: 7%;">Tax (%)</th>
            <th style="width: 9%;">Total (₹)</th>
        </tr>
    </thead>
    <tbody>
        <% lines.forEach(function (l) { %>
        <tr>
            <td class="text-center"><%= l.sno %></td>
            <td><strong><%= l.partCode %></strong></td>
            <td><%= l.description %></td>
            <td><%= l.manufacturer || '-' %></td>
            <td class="text-center"><%= l.qty %></td>
            <td class="text-center"><%= l.unit || 'PCS' %></td>
            <td class="text-right"><%= l.unitPrice %></td>
            <td class="text-center"><%= l.discountPct %>%</td>
            <td class="text-center"><%= l.taxRatePct %>% GST</td>
            <td class="text-right"><%= l.lineTotal %></td>
        </tr>
        <% }); %>
    </tbody>
</table>

<!-- Summary & Payment Terms Layout -->
<table class="summary-table-container">
    <tr>
        <td class="amount-words-cell" style="padding-right: 10px;">
            <div class="words-box">
                <div class="words-title">Amount in Words</div>
                <div class="words-content"><%= grandTotalWords %></div>
            </div>

            <div class="terms-box">
                <div class="section-title">Payment & Dispatch Terms</div>
                <ul class="terms-list">
                    <% dispatchTerms.forEach(function (t) { %>
                    <li><%- t %></li>
                    <% }); %>
                </ul>
            </div>
        </td>
        <td class="totals-cell">
            <table class="totals-table">
                <tr>
                    <td class="totals-label">Subtotal</td>
                    <td class="totals-value">₹ <%= subtotal %></td>
                </tr>
                <tr>
                    <td class="totals-label">Total Discount</td>
                    <td class="totals-value">- ₹ <%= discountTotal %></td>
                </tr>
                <tr>
                    <td class="totals-label">Taxable Amount</td>
                    <td class="totals-value">₹ <%= taxableAmount %></td>
                </tr>
                <tr>
                    <td class="totals-label">GST (<%= taxLabel %>)</td>
                    <td class="totals-value">₹ <%= taxTotal %></td>
                </tr>
                <tr class="grand-total-row">
                    <td class="totals-label">Grand Total</td>
                    <td class="totals-value">₹ <%= grandTotal %></td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<!-- Terms & Conditions & Signatory Layout -->
<table class="terms-section-table" style="margin-top: 5px;">
    <tr>
        <td style="padding-right: 8px;">
            <div class="terms-box">
                <div class="section-title">Terms & Conditions</div>
                <ol class="terms-list" style="padding-left: 15px;">
                    <% termsConditions.forEach(function (t) { %>
                    <li><%- t %></li>
                    <% }); %>
                </ol>
            </div>
        </td>
        <td style="padding-left: 8px;">
            <div class="terms-box" style="display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div class="section-title">Authorized Signatory</div>
                    <div class="sig-notice">This is a computer-generated quotation document valid without physical signature.</div>
                </div>
                <div class="sig-box">
                    <div class="sig-company">For <%= company.name %></div>
                    <div class="sig-line"></div>
                    <div class="sig-title">Authorized Signatory</div>
                </div>
            </div>
        </td>
    </tr>
</table>

</body>
</html>