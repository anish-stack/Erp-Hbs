generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Warehouse bounded context (database: erp_warehouse).
/// This service owns the physical topology (warehouses, zones, bins) that the
/// Inventory service's warehouseId / binLocation reference as plain ids.
/// partId / categoryId reference the Master Data service; no cross-db FKs.

model Warehouse {
  id                 String          @id @default(uuid()) @db.Char(36)
  code               String          @unique @db.VarChar(30)
  name               String          @db.VarChar(150)
  type               WarehouseType   @default(MAIN)
  status             WarehouseStatus @default(ACTIVE)

  addressLine1       String?         @db.VarChar(200)
  addressLine2       String?         @db.VarChar(200)
  city               String?         @db.VarChar(80)
  state              String?         @db.VarChar(80)
  pincode            String?         @db.VarChar(12)
  country            String          @default("India") @db.VarChar(80)

  contactName        String?         @db.VarChar(120)
  contactPhone       String?         @db.VarChar(30)
  contactEmail       String?         @db.VarChar(191)
  gstin              String?         @db.VarChar(15)

  isDefault          Boolean         @default(false)
  allowNegativeStock Boolean         @default(false)
  mslControlled      Boolean         @default(true)
  timezone           String          @default("Asia/Kolkata") @db.VarChar(40)
  notes              String?         @db.VarChar(1000)

  zones              Zone[]
  bins               Bin[]
  rules              PutawayRule[]
  tasks              WarehouseTask[]

  createdBy          String?         @db.Char(36)
  updatedBy          String?         @db.Char(36)
  deletedAt          DateTime?
  deletedBy          String?         @db.Char(36)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])
  @@index([type])
  @@map("warehouses")
}

model Zone {
  id                   String    @id @default(uuid()) @db.Char(36)

  warehouseId          String    @db.Char(36)
  warehouse            Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  code                 String    @db.VarChar(30)
  name                 String    @db.VarChar(120)
  type                 ZoneType  @default(STORAGE)

  temperatureControlled Boolean  @default(false)
  esdProtected         Boolean   @default(false)
  isActive             Boolean   @default(true)

  bins                 Bin[]

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([warehouseId, code], name: "zoneCode")
  @@index([warehouseId])
  @@index([type])
  @@map("zones")
}

model Bin {
  id            String    @id @default(uuid()) @db.Char(36)

  warehouseId   String    @db.Char(36)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  zoneId        String?   @db.Char(36)
  zone          Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  code          String    @db.VarChar(40)
  aisle         String?   @db.VarChar(20)
  rack          String?   @db.VarChar(20)
  shelf         String?   @db.VarChar(20)
  level         String?   @db.VarChar(20)

  binType       BinType   @default(SHELF)
  status        BinStatus @default(AVAILABLE)

  maxUnits      Int?
  maxWeightKg   Decimal?  @db.Decimal(12, 3)
  currentUnits  Int       @default(0)

  isPickable    Boolean   @default(true)
  isBulk        Boolean   @default(false)
  mslZone       Boolean   @default(false)
  notes         String?   @db.VarChar(500)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([warehouseId, code], name: "binCode")
  @@index([warehouseId])
  @@index([zoneId])
  @@index([status])
  @@map("bins")
}

model PutawayRule {
  id             String           @id @default(uuid()) @db.Char(36)

  warehouseId    String           @db.Char(36)
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  name           String           @db.VarChar(120)
  categoryId     String?          @db.Char(36)
  partId         String?          @db.Char(36)

  strategy       PutawayStrategy  @default(NEAREST)
  targetZoneType ZoneType?
  targetZoneId   String?          @db.Char(36)
  requiresMsl    Boolean          @default(false)

  priority       Int              @default(100)
  isActive       Boolean          @default(true)

  createdBy      String?          @db.Char(36)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([warehouseId])
  @@index([categoryId])
  @@index([priority])
  @@map("putaway_rules")
}

model WarehouseTask {
  id            String     @id @default(uuid()) @db.Char(36)
  code          String     @unique @db.VarChar(30)

  warehouseId   String     @db.Char(36)
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  type          TaskType
  status        TaskStatus @default(PENDING)

  partId        String     @db.Char(36)
  partCode      String?    @db.VarChar(60)
  quantity      Decimal    @db.Decimal(18, 3)
  uom           String     @default("PCS") @db.VarChar(12)

  fromBinId     String?    @db.Char(36)
  fromBinCode   String?    @db.VarChar(40)
  toBinId       String?    @db.Char(36)
  toBinCode     String?    @db.VarChar(40)

  refType       String?    @db.VarChar(30)
  refId         String?    @db.Char(36)
  refCode       String?    @db.VarChar(40)

  priority      Int        @default(100)
  assignedTo    String?    @db.Char(36)
  note          String?    @db.VarChar(500)

  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?    @db.VarChar(255)

  createdBy     String?    @db.Char(36)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([warehouseId, status])
  @@index([type, status])
  @@index([assignedTo])
  @@index([refType, refId])
  @@map("warehouse_tasks")
}

enum WarehouseType {
  MAIN
  BRANCH
  TRANSIT
  QUARANTINE
  RETURNS
  VIRTUAL
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum ZoneType {
  RECEIVING
  STORAGE
  DISPATCH
  QUARANTINE
  RETURNS
  STAGING
}

enum BinType {
  SHELF
  PALLET
  DRAWER
  REEL
  TRAY
  BULK
}

enum BinStatus {
  AVAILABLE
  BLOCKED
  FULL
  MAINTENANCE
}

enum PutawayStrategy {
  FIXED
  NEAREST
  ABC
  MSL_MATCH
  MANUAL
}

enum TaskType {
  PUTAWAY
  PICK
  MOVE
  COUNT
  REPLENISH
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
