INVENTORY_CACHE_TTL=300
DEFAULT_WAREHOUSE_ID=
VALUATION_METHOD=MOVING_AVERAGE
LOW_STOCK_SCAN_CRON=0 7 * * *
RESERVATION_SWEEP_CRON=*/15 * * * *
RESERVATION_TTL_HOURS=72

QUEUE_PREFIX=erp
QUEUE_CONCURRENCY=2
RUN_WORKERS_INLINE=true
