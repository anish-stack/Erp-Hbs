SERVICE_NAME=file-service
SERVICE_VERSION=1.0.0
FILE_SERVICE_PORT=4016
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

DATABASE_URL="mysql://erp:erp_password@mysql:3306/erp_file"

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-clients

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=erp:

RABBITMQ_URL=amqp://erp:erp_password@rabbitmq:5672
RABBITMQ_EXCHANGE=erp.events
RABBITMQ_DLX=erp.events.dlx

# ==========================================================
# STORAGE PROVIDER
# auto = pick the first configured provider (r2 -> cloudinary -> local)
# ==========================================================
STORAGE_PROVIDER=auto
SIGNED_URL_TTL=900
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_REQUEST=10
ORPHAN_RETENTION_HOURS=24

# Cloudflare R2 (preferred)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# Cloudinary (fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=erp

# Local (development only)
LOCAL_STORAGE_PATH=./storage/files
LOCAL_TMP_PATH=./storage/tmp
FILE_PUBLIC_BASE_URL=http://localhost:4016
LOCAL_SIGNING_SECRET=change_me_local_signing_secret

# Image processing
THUMBNAIL_SIZES=160,480,1024
IMAGE_QUALITY=82

QUEUE_PREFIX=erp
QUEUE_CONCURRENCY=3
RUN_WORKERS_INLINE=true
