SERVICE_NAME=auth-service
SERVICE_VERSION=1.0.0
AUTH_SERVICE_PORT=4001
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

DATABASE_URL="mysql://erp:erp_password@mysql:3306/erp_auth"

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-clients
BCRYPT_ROUNDS=12

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=erp:

RABBITMQ_URL=amqp://erp:erp_password@rabbitmq:5672
RABBITMQ_EXCHANGE=erp.events
RABBITMQ_DLX=erp.events.dlx

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30
PERMISSION_CACHE_TTL=900

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=ERP Platform
MAIL_FROM_ADDRESS=no-reply@example.com
APP_NAME=Enterprise ERP
APP_URL=http://localhost:3000

QUEUE_PREFIX=erp
EMAIL_QUEUE_ATTEMPTS=5
EMAIL_QUEUE_BACKOFF_MS=5000
RUN_WORKERS_INLINE=true

SEED_SUPER_ADMIN_EMAIL=admin@erp.local
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_SUPER_ADMIN_NAME=System Administrator
