SERVICE_NAME=inventory-service
SERVICE_VERSION=1.0.0
INVENTORY_SERVICE_PORT=4009
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

DATABASE_URL="mysql://root:@localhost:3306/erp_inventory"

JWT_ACCESS_SECRET=5ea1accf10dd1e8eb82f074d2ad1220e9ae24503ca9a76f77794b293875de283
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-clients

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=erp:

RABBITMQ_URL=amqp://erp:erp_password@127.0.0.1:5672
RABBITMQ_EXCHANGE=erp.events
RABBITMQ_DLX=erp.events.dlx

# Internal service endpoints
MASTER_SERVICE_URL=http://127.0.0.1:4004
WAREHOUSE_SERVICE_URL=http://127.0.0.1:4010
