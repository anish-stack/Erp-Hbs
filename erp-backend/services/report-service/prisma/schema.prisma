generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Report bounded context (database: erp_report). Generated files are stored
/// via the File service; fileId references it (no cross-db FK).

model ReportRun {
  id           String       @id @default(uuid()) @db.Char(36)
  code         String       @unique @db.VarChar(30)

  reportKey    String       @db.VarChar(60) // e.g. "sales-orders-register"
  reportName   String       @db.VarChar(150)
  format       ReportFormat @default(XLSX)
  status       RunStatus    @default(QUEUED)

  params       Json?
  rowCount     Int?

  fileId       String?      @db.Char(36)
  fileName     String?      @db.VarChar(200)
  downloadPath String?      @db.VarChar(255)

  error        String?      @db.VarChar(1000)

  requestedBy  String?      @db.Char(36)

  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([reportKey])
  @@index([status])
  @@index([requestedBy])
  @@map("report_runs")
}

model ReportSchedule {
  id          String   @id @default(uuid()) @db.Char(36)
  reportKey   String   @db.VarChar(60)
  reportName  String   @db.VarChar(150)
  format      ReportFormat @default(XLSX)
  params      Json?
  cron        String   @db.VarChar(60)
  recipientId String?  @db.Char(36)
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?

  createdBy   String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reportKey])
  @@index([isActive])
  @@map("report_schedules")
}

enum ReportFormat {
  XLSX
  CSV
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}
