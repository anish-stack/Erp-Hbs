SERVICE_NAME=master-service
SERVICE_VERSION=1.0.0
MASTER_SERVICE_PORT=4004
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

DATABASE_URL="mysql://erp:erp_password@mysql:3306/erp_master"

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-clients

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=erp:

RABBITMQ_URL=amqp://erp:erp_password@rabbitmq:5672
RABBITMQ_EXCHANGE=erp.events
RABBITMQ_DLX=erp.events.dlx

MASTER_CACHE_TTL=1800
PART_SEARCH_LIMIT=25
BASE_CURRENCY=INR
