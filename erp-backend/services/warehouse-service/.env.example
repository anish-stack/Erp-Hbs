SERVICE_NAME=warehouse-service
SERVICE_VERSION=1.0.0
WAREHOUSE_SERVICE_PORT=4010
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

DATABASE_URL="mysql://root:@localhost:3306/erp_warehouse"

JWT_ACCESS_SECRET=5ea1accf10dd1e8eb82f074d2ad1220e9ae24503ca9a76f77794b293875de283
