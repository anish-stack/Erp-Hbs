SERVICE_NAME=audit-service
SERVICE_VERSION=1.0.0
AUDIT_SERVICE_PORT=4019
NODE_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

DATABASE_URL="mysql://erp:erp_password@mysql:3306/erp_audit"

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-clients

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=erp:

RABBITMQ_URL=amqp://erp:erp_password@rabbitmq:5672
RABBITMQ_EXCHANGE=erp.events
RABBITMQ_DLX=erp.events.dlx
RABBITMQ_PREFETCH=50

QUEUE_PREFIX=erp
QUEUE_CONCURRENCY=2
RUN_WORKERS_INLINE=true
EXPORT_DIR=./storage/exports
EXPORT_RETENTION_HOURS=24

AUDIT_RETENTION_DAYS=730
AUDIT_ROLLUP_CRON=15 1 * * *
AUDIT_PURGE_CRON=45 2 * * *
AUDIT_STATS_CACHE_TTL=300
AUDIT_MAX_PAYLOAD_KB=64
